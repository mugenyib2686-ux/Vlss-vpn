{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "http-in-tcp",
      "listen": "127.0.0.1",
      "port": 1090,
      "protocol": "http"
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "tag": "vless-tcp-out",
      "settings": {
        "vnext": [
          {
            "address": "127.0.0.1",
            "port": 10000,
            "users": [
              {
                "id": "99999999-9999-9999-9999-999999999999",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none"
      }
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "http-in-tcp"
        ],
        "outboundTag": "vless-tcp-out"
      }
    ]
  }
}